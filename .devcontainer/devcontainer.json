{
  "name": "Workplace backend",
  "dockerComposeFile": "../compose.dev.yaml",
  "service": "dev",
  "runServices": [
    "dev",
    "nginx",
    "frontend",
    "gateway",
    "users",
    "booking",
    "assistant",
    "users-outbox",
    "booking-outbox",
    "assistant-outbox",
    "users-booking-events",
    "booking-user-events",
    "assistant-booking-events",
    "assistant-generations"
  ],
  "workspaceFolder": "/workspace",
  "shutdownAction": "none",
  "overrideCommand": false,
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["-p", "no:cacheprovider"]
      }
    }
  }
}
