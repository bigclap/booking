# Copy to .env.prod and supply your own values. No production credential has a default.
POSTGRES_PASSWORD=
USERS_DB_PASSWORD=
BOOKING_DB_PASSWORD=
ASSISTANT_DB_PASSWORD=
INTERNAL_API_KEY=
WEB_JWT_SECRET=
PUBLIC_BASE_URL=https://booking.example.com
MCP_ENCRYPTION_KEY=
MCP_ACCESS_TTL_SECONDS=600
MCP_REFRESH_DAYS=30
ALLOWED_ORIGINS=["https://booking.example.com"]
HTTP_BIND=127.0.0.1
# The single Nginx entry point; place an HTTPS terminator in front for production cookies.
HTTP_PORT=8080
IMAGE_TAG=local
BOOKING_STEP_MINUTES=5
BOOKING_HORIZON_DAYS=7
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=Администратор
BOOTSTRAP_ADMIN_LAST_NAME=Офиса
