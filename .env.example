# Optional overrides for the local Docker development stack; never use these in production.
# The single public Nginx port serves the UI, /api/ and /mcp.
FRONTEND_PORT=5178
PUBLIC_BASE_URL=http://localhost:5178
MCP_ENCRYPTION_KEY=local-mcp-client-encryption-key-change-before-deploy
MCP_ACCESS_TTL_SECONDS=600
MCP_REFRESH_DAYS=30
POSTGRES_PASSWORD=postgres-local-only
USERS_DB_PASSWORD=users-local-only
BOOKING_DB_PASSWORD=booking-local-only
ASSISTANT_DB_PASSWORD=assistant-local-only
INTERNAL_API_KEY=local-development-internal-key-change-before-deploy
WEB_JWT_SECRET=local-web-signing-key-change-before-deploy-32chars
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:5178","http://127.0.0.1:5178"]
BOOKING_STEP_MINUTES=5
BOOKING_HORIZON_DAYS=7
# Set both values to enable generation with your OpenRouter account.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Used only by `make bootstrap`; never printed or automatically reset.
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=Администратор
BOOTSTRAP_ADMIN_LAST_NAME=Офиса
